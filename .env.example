# ── Veecos site environment ──
# Copy to .env.local for development; set the same vars in your host
# (Vercel / Amplify) for production.

# Backend API base. Prefer API_BASE (server-only — never shipped to the
# browser). NEXT_PUBLIC_API_BASE is still read as a fallback but, being a
# public var, is less private. Both fall back to the production URL in
# src/lib/api.ts if unset.
API_BASE=https://mbevr3vs87.execute-api.ap-south-1.amazonaws.com

# Shared secret for on-demand cache busting (POST /api/revalidate).
# The admin panel sends this as the `x-revalidate-secret` header after a
# product/category change so updates appear on the site instantly.
# Use a long random value. If unset, the endpoint stays disabled (401).
REVALIDATE_SECRET=

# Login for the SEO dashboard at /seo (HTTP Basic Auth, enforced in
# src/middleware.ts). BOTH must be set or the page returns 503 — it fails
# closed so a missing value can never leave the dashboard public.
SEO_USER=veecos
SEO_PASSWORD=

# Optional: set to 1 to log every backend API call (URL, status, timing) to
# the server console. Leave unset in production.
VEECOS_API_DEBUG=
